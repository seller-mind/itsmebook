# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/create
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/create

# 火山引擎 - Doubao文本模型（故事生成）
# 文档：https://www.volcengine.com/docs/82379/1263482
VOLCENGINE_API_KEY=your_volcengine_api_key_here
# 推理接入点ID（从火山引擎控制台创建推理接入点获得）
# 格式如 ep-xxxxxxxxxx，默认使用 doubao-seed-2.0-pro
VOLCENGINE_ENDPOINT_ID=doubao-seed-2.0-pro

# 阿里云百炼 - 万相2.7图片模型（图片生成）
# 文档：https://help.aliyun.com/zh/dashscope/
# 新用户50张免费额度（90天内）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Supabase (数据库)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx

# Replicate (AI图像生成，后续升级使用)
REPLICATE_API_TOKEN=r8_xxxxx

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# 旧版OpenAI配置（已弃用，可删除）
# ==========================================
# OPENAI_API_KEY=sk-xxxxx
