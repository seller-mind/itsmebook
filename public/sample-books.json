  {
    "id": "sample-3",
    "title": "阿宝的叶约",
    "style": "chinese",
    "theme": "nature",
    "characterName": "阿宝",
    "characterGender": "男孩",
    "characterAge": "7",
    "appearanceChinese": "7岁虎头虎脑男孩，短寸头，身着干净白色对襟小褂，眉眼圆钝带着憨气",
    "coverImage": "/sample-images/sample-3-cover.png",
    "author": "是我呀示例",
    "pages": [
      {
        "pageNumber": 1,
        "text": "秋阳晒软后院的柿树，阿宝踮脚扒着树干，盯着满枝飘晃的金叶子直眨眼。",
        "imageUrl": "/sample-images/sample-3-page-1.png"
      },
      {
        "pageNumber": 2,
        "text": "风卷着第一片柿叶擦过他耳尖，阿宝攥紧叶边，想把它塞回空枝丫上。",
        "imageUrl": "/sample-images/sample-3-page-2.png"
      },
      {
        "pageNumber": 3,
        "text": "叶子牵着他的指尖往林子里钻，脚边碎叶沙沙响，像藏着数不清的小秘密。",
        "imageUrl": "/sample-images/sample-3-page-3.png"
      },
      {
        "pageNumber": 4,
        "text": "小松鼠叼着松果蹭过他脚背，摆摆大尾巴，引他去看埋在土缝的橡果。",
        "imageUrl": "/sample-images/sample-3-page-4.png"
      },
      {
        "pageNumber": 5,
        "text": "枯荷盖下蜷着几只青蛙，鼓着腮帮子呱呱叫，指了指水面飘转的残荷瓣。",
        "imageUrl": "/sample-images/sample-3-page-5.png"
      },
      {
        "pageNumber": 6,
        "text": "穿蓝布衫的老蜂农坐在田埂，递给他半块桂花糕，指向坡底歇冬的蜂箱。",
        "imageUrl": "/sample-images/sample-3-page-6.png"
      },
      {
        "pageNumber": 7,
        "text": "蚂蚁排着长队拖饭粒，绕开阿宝的布鞋尖，往落叶堆的小洞里钻去。",
        "imageUrl": "/sample-images/sample-3-page-7.png"
      },
      {
        "pageNumber": 8,
        "text": "风裹着桂香绕他转三圈，把满林子的落叶都卷成慢悠悠打旋的金漩涡。",
        "imageUrl": "/sample-images/sample-3-page-8.png"
      },
      {
        "pageNumber": 9,
        "text": "他跟着落叶涡往山坳走，看见老茶树的叶片铺了厚厚一层，盖着土里的芽尖。",
        "imageUrl": "/sample-images/sample-3-page-9.png"
      },
      {
        "pageNumber": 10,
        "text": "路过的老黄牛甩甩尾巴，蹭了蹭他的发顶，哞一声，指向山尖落下去的太阳。",
        "imageUrl": "/sample-images/sample-3-page-10.png"
      },
      {
        "pageNumber": 11,
        "text": "他把攥了一路的柿叶放到落叶堆上，忽然听见叶层底下传来细细的鼾声。",
        "imageUrl": "/sample-images/sample-3-page-11.png"
      },
      {
        "pageNumber": 12,
        "text": "月光漫过林梢时，阿宝踩着叶影往家走，口袋里塞了颗松鼠送的饱满橡果。",
        "imageUrl": "/sample-images/sample-3-page-12.png"
      },
      {
        "pageNumber": 13,
        "text": "一夜霜风过后，窗玻璃结满冰花，阿宝趴在窗台，数着枝丫上的空缺口。",
        "imageUrl": "/sample-images/sample-3-page-13.png"
      },
      {
        "pageNumber": 14,
        "text": "他把橡果埋在柿树底下，盖了层软乎乎的腐叶，像给小芽盖了层厚棉被。",
        "imageUrl": "/sample-images/sample-3-page-14.png"
      },
      {
        "pageNumber": 15,
        "text": "落雪的日子他趴在暖炕头，听奶奶讲春燕归巢的旧事，指尖蹭着窗沿数日子。",
        "imageUrl": "/sample-images/sample-3-page-15.png"
      },
      {
        "pageNumber": 16,
        "text": "河冰裂开细纹路的那天，阿宝跑到林边，看见土缝里顶出星星点点的嫩绿尖。",
        "imageUrl": "/sample-images/sample-3-page-16.png"
      },
      {
        "pageNumber": 17,
        "text": "满树柿芽冒头时，第一只新燕擦着他的耳边飞过，停在去年落过叶的枝桠上。",
        "imageUrl": "/sample-images/sample-3-page-17.png"
      },
      {
        "pageNumber": 18,
        "text": "阿宝忽然懂了，去年飘走的叶子，从来不是和柿树说再见，是约好了春天见。",
        "imageUrl": "/sample-images/sample-3-page-18.png"
      },
      {
        "pageNumber": 19,
        "text": "他埋的橡果钻出两瓣嫩黄的芽，风一吹，晃悠悠朝他招了招小叶子。",
        "imageUrl": "/sample-images/sample-3-page-19.png"
      },
      {
        "pageNumber": 20,
        "text": "风慢悠悠吹过新叶，万物都踩着自己的步子，不慌不忙，刚好赴约。",
        "imageUrl": "/sample-images/sample-3-page-20.png"
      }
    ]
  }
]