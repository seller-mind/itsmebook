[
  {
    "id": "sample-1",
    "title": "小宇的小灯",
    "style": "watercolor",
    "theme": "adventure",
    "characterName": "小宇",
    "characterGender": "男孩",
    "characterAge": "5",
    "appearanceChinese": "5岁圆脸男孩，大眼睛，利落短发，始终穿着干净的蓝色短袖T恤",
    "coverImage": "/sample-images/sample-1-cover.png",
    "author": "是我呀示例",
    "pages": [
      {
        "pageNumber": 1,
        "text": "夏末的傍晚，小宇攥着半块橘子冰，蹲在老院门槛边数爬过墙根的小蜗牛。",
        "imageUrl": "/sample-images/sample-1-page-1.png"
      },
      {
        "pageNumber": 2,
        "text": "奶奶从里屋探出头笑，说院后老林里的山枣红透了，晒得比蜜还甜。",
        "imageUrl": "/sample-images/sample-1-page-2.png"
      },
      {
        "pageNumber": 3,
        "text": "小宇挎着小竹篮蹦跳往林边走，风卷着梧桐叶擦过他的蓝T恤衣角。",
        "imageUrl": "/sample-images/sample-1-page-3.png"
      },
      {
        "pageNumber": 4,
        "text": "天忽然暗了大半，厚云把太阳整个裹住，林子里的树影歪歪扭扭晃起来。",
        "imageUrl": "/sample-images/sample-1-page-4.png"
      },
      {
        "pageNumber": 5,
        "text": "远处传来闷沉沉的雷声，小宇的指尖瞬间攥紧了篮边，后背冒出细细的冷汗。",
        "imageUrl": "/sample-images/sample-1-page-5.png"
      },
      {
        "pageNumber": 6,
        "text": "他想起上周听阿明说林深处藏着“大黑影”，脚像粘在泥地上，半步都挪不动。",
        "imageUrl": "/sample-images/sample-1-page-6.png"
      },
      {
        "pageNumber": 7,
        "text": "风刮得树叶沙沙响，像有人躲在暗处小声说话，小宇的耳朵尖都凉透了。",
        "imageUrl": "/sample-images/sample-1-page-7.png"
      },
      {
        "pageNumber": 8,
        "text": "他下意识往后退了半步，鞋底蹭到软乎乎的青苔，差点摔坐在湿草地上。",
        "imageUrl": "/sample-images/sample-1-page-8.png"
      },
      {
        "pageNumber": 9,
        "text": "小宇的心跳得咚咚响，像怀里揣了只乱撞的小兔子，连呼吸都放得轻轻的。",
        "imageUrl": "/sample-images/sample-1-page-9.png"
      },
      {
        "pageNumber": 10,
        "text": "他转头望向院的方向，家的轮廓藏在树后面，被层层叠叠的树叶挡得严严实实。",
        "imageUrl": "/sample-images/sample-1-page-10.png"
      },
      {
        "pageNumber": 11,
        "text": "裤兜里忽然硌了一下，是昨天爸爸送他的迷你手电，按开就跳出暖黄的小光。",
        "imageUrl": "/sample-images/sample-1-page-11.png"
      },
      {
        "pageNumber": 12,
        "text": "那点光落在脚边的草叶上，把细碎的小绒毛都照得清清楚楚，暖融融的。",
        "imageUrl": "/sample-images/sample-1-page-12.png"
      },
      {
        "pageNumber": 13,
        "text": "小宇咬了咬嘴唇，把小手电举到身前，一步一顿朝着山枣的方向慢慢走。",
        "imageUrl": "/sample-images/sample-1-page-13.png"
      },
      {
        "pageNumber": 14,
        "text": "树影晃到他脚边，他用手电照过去，哪有什么大黑影，只是歪倒的老枯树干。",
        "imageUrl": "/sample-images/sample-1-page-14.png"
      },
      {
        "pageNumber": 15,
        "text": "雷声远了，风也软下来，转过一块凸起来的大石坡，满树的红通通山枣撞进眼里。",
        "imageUrl": "/sample-images/sample-1-page-15.png"
      },
      {
        "pageNumber": 16,
        "text": "他踮着脚把最红最圆的山枣摘下来，一颗一颗轻轻放进挎着的小竹篮里。",
        "imageUrl": "/sample-images/sample-1-page-16.png"
      },
      {
        "pageNumber": 17,
        "text": "装得满满当当的小竹篮沉乎乎的，小宇挎着它，胸口的小兔子终于慢慢安静下来。",
        "imageUrl": "/sample-images/sample-1-page-17.png"
      },
      {
        "pageNumber": 18,
        "text": "推开院门的瞬间，奶奶举着小灯站在屋檐下，暖光把小宇的蓝T恤染成软融融的浅蓝。",
        "imageUrl": "/sample-images/sample-1-page-18.png"
      },
      {
        "pageNumber": 19,
        "text": "咬开一颗山枣，蜜甜的汁水流进喉咙，小宇忽然发现刚才怕得发抖的自己超厉害。",
        "imageUrl": "/sample-images/sample-1-page-19.png"
      },
      {
        "pageNumber": 20,
        "text": "晚风揉着橘色的晚霞，小宇攥着手里的小灯，知道勇敢从来不是不害怕呀。",
        "imageUrl": "/sample-images/sample-1-page-20.png"
      }
    ]
  },
  {
