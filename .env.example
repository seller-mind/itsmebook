# ============================================
# 「是我呀」环境变量配置
# ============================================
# 复制此文件为 .env.local 并填写实际值

# ============================================
# Supabase 配置
# ============================================
# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://lhxrauqvqvehhqbzvzjr.supabase.co

# Anon Key (公开的，安全)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (仅服务端使用，不要泄露)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# 阿里云短信认证配置
# ============================================
# AccessKey ID (从阿里云 RAM 控制台获取)
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id

# AccessKey Secret (从阿里云 RAM 控制台获取)
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret

# ============================================
# JWT 配置
# ============================================
# JWT 密钥（建议使用随机字符串，可以使用 openssl rand -base64 32 生成）
JWT_SECRET=your-jwt-secret-change-in-production

# ============================================
# AI 图片生成 API (可选)
# ============================================
# 火山引擎 / Doubao API
# DOUBAO_API_KEY=your-doubao-api-key

# ============================================
# 虎皮椒支付配置
# ============================================
# 在虎皮椒控制台获取 AppID 和 AppSecret
# 官网: https://www.xunhupay.com/
XUNHUPAY_APP_ID=your-xunhupay-app-id

# 通信密钥
XUNHUPAY_APP_SECRET=your-xunhupay-app-secret

# 虎皮椒网关地址（通常不需要修改）
XUNHUPAY_GATEWAY=https://api.xunhupay.com/payment/do.html

# 应用URL（用于支付回调通知）
NEXT_PUBLIC_APP_URL=https://www.itsmebook.com

# ============================================
# Vercel 部署环境变量
# ============================================
# 在 Vercel Project Settings -> Environment Variables 中添加：
# 
# NEXT_PUBLIC_SUPABASE_URL = https://lhxrauqvqvehhqbzvzjr.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY = your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY = your-supabase-service-role-key
# ALIYUN_ACCESS_KEY_ID = your-aliyun-access-key-id
# ALIYUN_ACCESS_KEY_SECRET = your-aliyun-access-key-secret
# JWT_SECRET = your-jwt-secret
# XUNHUPAY_APP_ID = your-xunhupay-app-id
# XUNHUPAY_APP_SECRET = your-xunhupay-app-secret
# XUNHUPAY_GATEWAY = https://api.xunhupay.com/payment/do.html
# NEXT_PUBLIC_APP_URL = https://www.itsmebook.com

# ============================================
# 百度统计配置
# ============================================
# 在百度统计官网 (https://tongji.baidu.com) 注册并获取统计ID
# 格式：32位字母数字组合
NEXT_PUBLIC_BAIDU_ANALYTICS_ID=
